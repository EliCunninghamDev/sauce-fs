# Generated from docs/Doxyfile.in by CMake; edit the template instead.
#
# Doxygen only produces XML here. Breathe reads that XML inside Sphinx, which
# owns the HTML output and the site navigation.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@SAUCE_FS_VERSION@"
PROJECT_BRIEF          = "Read-only access to Source engine content archives"
OUTPUT_DIRECTORY       = "@SAUCE_FS_DOXYGEN_OUTPUT@"

# Keep the documented names short: the API is read from a single public tree.
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = "@SAUCE_FS_SOURCE_DIR@"
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = "@SAUCE_FS_SOURCE_DIR@/README.md"

INPUT                  = "@SAUCE_FS_SOURCE_DIR@/include/sauce/core" \
                         "@SAUCE_FS_SOURCE_DIR@/src/fuse/archive_mount.hpp" \
                         "@SAUCE_FS_SOURCE_DIR@/README.md"
INCLUDE_PATH           = "@SAUCE_FS_SOURCE_DIR@/include"
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
INPUT_ENCODING         = UTF-8

# Everything public is part of the reference, even when a declaration has no
# doc comment yet. Undocumented warnings stay off so the build is not blocked
# on prose; malformed comments are still errors.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
QUIET                  = YES

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
HAVE_DOT               = NO
