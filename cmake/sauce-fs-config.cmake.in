@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# sauce_fs_core is a static library, so its implementation dependencies also
# appear on the consumer's link line.
find_dependency(Threads)
find_dependency(fmt CONFIG)
find_dependency(SQLite3)
find_dependency(LibLZMA)
find_dependency(ZLIB)
find_dependency(xxHash CONFIG)
find_dependency(efsw CONFIG)

# CMake 3.31 renamed SQLite::SQLite3 to SQLite3::SQLite3. The exported target
# records whichever name was used at build time, so provide the other alias.
if(NOT TARGET SQLite::SQLite3 AND TARGET SQLite3::SQLite3)
    add_library(SQLite::SQLite3 ALIAS SQLite3::SQLite3)
elseif(NOT TARGET SQLite3::SQLite3 AND TARGET SQLite::SQLite3)
    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/sauce-fs-targets.cmake")

check_required_components(sauce-fs)
